GOOGLE_AI_STUDIO_API_KEY=your_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash-latest
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.9
GEMINI_TOP_K=32
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_USE_SCHEMA=true
AI_SERVICE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ai_skincare
AI_SERVICE_DB_POOL_MIN_SIZE=1
AI_SERVICE_DB_POOL_MAX_SIZE=5
AI_SERVICE_DB_STATEMENT_TIMEOUT_MS=10000
AI_SERVICE_IMAGE_MAX_BYTES=4194304
AI_SERVICE_CACHE_TTL_SECONDS=900
AI_SERVICE_MAX_CONCURRENT=4
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY=1.0
GEMINI_RETRY_BACKOFF=2.0
AI_SERVICE_IMAGE_MAX_WIDTH=4096
AI_SERVICE_IMAGE_MAX_HEIGHT=4096
AI_SERVICE_SCAN_ENDPOINT=
AI_SERVICE_SCAN_TIMEOUT_SECONDS=10
AI_SERVICE_RATE_LIMIT_PER_USER=5
AI_SERVICE_RATE_LIMIT_PER_IP=15
AI_SERVICE_RATE_LIMIT_WINDOW_SECONDS=60
GEMINI_ALLOWED_MODELS=gemini-1.5-flash-latest,gemini-1.5-pro-latest
GEMINI_COMPARE_MODELS=gemini-1.5-pro-latest
ANALYSIS_DEFAULT_DETAIL_LEVEL=medium
AI_SERVICE_RETENTION_DAYS=180
AI_SERVICE_RETENTION_BATCH_SIZE=200
ANALYSIS_EVENT_WEBHOOK=
ANALYSIS_EVENT_TIMEOUT_SECONDS=5
ANALYSIS_SLOW_THRESHOLD_MS=8000
GOOGLE_AI_STUDIO_API_KEY_FILE=
GOOGLE_AI_API_KEY_REFRESH_SECONDS=300
