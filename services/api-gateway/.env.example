# API Gateway configuration
PORT=3000
NODE_ENV=development

# Secret for verifying JWT from auth service (must match auth-service)
JWT_ACCESS_SECRET=your_jwt_secret_here

# Comma-separated list of allowed origins (use * for all)
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (defaults: 15 minutes window, 300 requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Proxy timeout in milliseconds
PROXY_TIMEOUT_MS=15000

# Downstream service URLs
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3004
PRODUCT_SERVICE_URL=http://product-service:3003
AI_SERVICE_URL=http://ai-service:3006
RECOMMENDATION_SERVICE_URL=http://recommendation-service:3005
EXPERT_SERVICE_URL=http://expert-service:3002
